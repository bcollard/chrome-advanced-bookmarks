{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Advanced Bookmarks",
  "version": "1.2.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://bcollard.github.io/chrome-advanced-bookmarks/",
  "permissions": [
    "bookmarks",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "__MSG_cmdOpenDialog__"
    }
  }
}
